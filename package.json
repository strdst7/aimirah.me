{
  "name": "aimirah-me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monorepo root for the aimirah.me sites. Currently hosts shared tooling (tests); workspace hoisting tracked in .planning/codebase/CONCERNS.md #1.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "clone-reframed-online-website",
    "aimirah-mixtape",
    "clone-string-tune-website",
    "kdmirah-studio",
    "pasarapi-mini-bounty-announcement"
  ]
}
